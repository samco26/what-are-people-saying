# Copy to .env.local for local development, or set these in Vercel's
# Environment Variables. Keys belong only there: never in browser code and
# never in this file. .env.local is ignored by git.
#
# Every key is optional. With none set, the app answers the six example
# subjects from labelled fictional samples and nothing else. The live search
# switches on as soon as OPENAI_API_KEY and at least one source key exist.
# A source without its key is reported as unavailable in the answer rather
# than failing the search.

# --- Analysis (required for any live answer) ---
# From https://platform.openai.com/api-keys. The model reads the collected
# sample and writes the answer.
OPENAI_API_KEY=
# Which OpenAI API model reads the sample. GPT-5.6 Luna is the inexpensive
# default for initial testing. Change this value to compare another model
# that supports Structured Outputs through the Responses API.
CONSENSUS_MODEL=gpt-5.6-luna

# --- YouTube (Google Cloud console, YouTube Data API v3, an API key) ---
YOUTUBE_API_KEY=
# How many videos to search and how many top comments to read on each.
YOUTUBE_MAX_VIDEOS=8
YOUTUBE_COMMENTS_PER_VIDEO=20

# --- X (developer.x.com, an app with a Bearer token; recent search covers
#     the last seven days) ---
X_BEARER_TOKEN=
# Posts per search, 10 to 100. X bills by posts read, so this is the spend
# control: 50 posts a search at the Basic tier's monthly cap is about 200
# searches a month.
X_MAX_RESULTS=50
# A best-effort daily ceiling on posts read, per server instance.
X_DAILY_POST_BUDGET=1000

# --- Reddit (reddit.com/prefs/apps, a "script" app; the user agent must
#     name the app and your username) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:what-are-people-saying:v1 (by /u/your_username)
REDDIT_MAX_POSTS=10
REDDIT_COMMENTS_PER_POST=12

# --- Collection ---
# Fewer items than this and the search reports that there was not enough to
# go on rather than answering.
MIN_ITEMS=8
